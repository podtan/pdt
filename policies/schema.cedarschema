// PDT Cedar Schema
//
// Defines entity types and actions for Cedar authorization.
// Entity attributes are populated from multiple sources:
//   - AuthContext fields (visibility, confidentiality, owner_groups)
//   - Tag-derived fields (status, asset_type) read at eval time
//   - Asset direct fields (created_by)

entity User = {
    email?: String,
    role?: String,
    groups?: Set<String>,
    // Sub/SPN-keyed team matching (CPO ruling eda88e15, 2026-10-23):
    // sub = JWT sub verbatim; spn = <preferred_username>@<issuer-domain>.
    sub?: String,
    spn?: String,
};

entity Asset = {
    created_by?: Set<User>,
    visibility?: String,
    confidentiality?: String,
    owner_groups?: Set<String>,
    status?: String,
    asset_type?: String,
};

action View, Create, Edit, Delete, Tag, Relate appliesTo {
    principal: [User],
    resource: [Asset],
};

// Workspace-management actions (WS-B 99035dee): membership + agent writes
// are NOT asset CRUD — they carry the caller's resolved seat role in the
// CONTEXT (per-request, per-workspace data; the principal stays
// workspace-agnostic per the tenancy model). caller_role = the caller's
// membership role on the target workspace (owner | ws_admin | member |
// none); target_seat_role = the target principal's current seat on that
// workspace ("none" when absent); requested_role = the seat being written
// (has_access creates only).
action ManageMembers, ManageWorkspaceAgents appliesTo {
    principal: [User],
    resource: [Asset],
    context: {
        caller_role: String,
        target_seat_role?: String,
        requested_role?: String,
    },
};
